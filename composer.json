  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.0",
    "ramsey/uuid": "^4.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
